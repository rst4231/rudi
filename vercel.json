{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/labor-daily-cron": false,
      "fix/daily-content-reliability-clean": false,
      "fix/daily-content-repair-20260824": false,
      "fix/alice-product-phrases": false,
      "feat/events-cinema-premieres": false,
      "fix/cinema-poster-proxy": false,
      "fix/cinema-collage": false,
      "fix/cinema-topic-and-events-fallback": false,
      "fix/cinema-explicit-migrate": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- api runtime build.cjs package.json vercel.json public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/daily-cron.js": {
      "maxDuration": 300
    },
    "api/recover-20260823.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/daily",
      "destination": "/api/daily-cron?route=daily"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/index?route=telegram"
    },
    {
      "source": "/api/alice",
      "destination": "/api/index?route=alice-shopping"
    },
    {
      "source": "/api/alice-shopping",
      "destination": "/api/index?route=alice-shopping"
    },
    {
      "source": "/api/init-products",
      "destination": "/api/index?route=init-products"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "30 21 * * *"
    }
  ]
}
