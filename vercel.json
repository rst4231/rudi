{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- api runtime build.cjs package.json vercel.json public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/daily-cron.js": {
      "maxDuration": 300
    },
    "api/stylist-leads-cron.js": {
      "maxDuration": 300
    },
    "api/feed-notify-cron.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/app.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/feed",
      "destination": "/api/partner-message?rudiAction=feed"
    },
    {
      "source": "/api/for-di",
      "destination": "/api/feed-notify-cron?mode=for-di"
    },
    {
      "source": "/api/mood",
      "destination": "/api/partner-message?rudiAction=mood"
    },
    {
      "source": "/api/cycle",
      "destination": "/api/partner-message?rudiAction=cycle"
    },
    {
      "source": "/api/cycle/bootstrap",
      "destination": "/api/partner-message?rudiAction=cycle-bootstrap"
    },
    {
      "source": "/api/partner-notifications/setup",
      "destination": "/api/partner-message?rudiAction=partner-notification-setup"
    },
    {
      "source": "/api/shared-album",
      "destination": "/api/partner-message?rudiAction=shared-album"
    },
    {
      "source": "/api/shared-album/setup",
      "destination": "/api/partner-message?rudiAction=shared-album-setup"
    },
    {
      "source": "/api/wishlist",
      "destination": "/api/partner-message?rudiAction=wishlist"
    },
    {
      "source": "/api/work-calendar",
      "destination": "/api/partner-message?rudiAction=work-calendar"
    },
    {
      "source": "/api/work-calendar/setup",
      "destination": "/api/partner-message?rudiAction=work-calendar-setup"
    },
    {
      "source": "/api/ticktick/connect",
      "destination": "/api/partner-message?ticktickAction=connect"
    },
    {
      "source": "/api/ticktick/callback",
      "destination": "/api/partner-message?ticktickAction=callback"
    },
    {
      "source": "/api/ticktick/next",
      "destination": "/api/partner-message?ticktickAction=next"
    },
    {
      "source": "/api/ticktick/calendar",
      "destination": "/api/partner-message?ticktickAction=calendar"
    },
    {
      "source": "/api/ticktick/checklist-toggle",
      "destination": "/api/partner-message?ticktickAction=checklist-toggle"
    },
    {
      "source": "/api/daily",
      "destination": "/api/daily-cron?route=daily"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/index?route=telegram"
    },
    {
      "source": "/api/alice",
      "destination": "/api/index?route=alice-shopping"
    },
    {
      "source": "/api/alice-shopping",
      "destination": "/api/index?route=alice-shopping"
    },
    {
      "source": "/api/init-products",
      "destination": "/api/index?route=init-products"
    },
    {
      "source": "/api/ticktick/today",
      "destination": "/api/partner-message?ticktickAction=today"
    },
    {
      "source": "/api/ticktick/task-complete",
      "destination": "/api/partner-message?ticktickAction=task-complete"
    },
    {
      "source": "/api/rudi-jwks",
      "destination": "/api/index?route=rudi-jwks"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/stylist-leads-cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/feed-notify-cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/for-di",
      "schedule": "0 9 * * *"
    }
  ],
  "env": {
    "NODE_OPTIONS": "--disable-warning=DEP0169"
  }
}
